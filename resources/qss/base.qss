/* ==========================================================================
   MessengerApp — базовые стили.
   Плейсхолдеры {{token}} подставляются ThemeManager (см. app/ThemeManager.cpp).
   ========================================================================== */

QWidget {
    color: {{text}};
    font-family: "Segoe UI", "Inter", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 10pt;
}

QMainWindow,
QDialog,
#Root {
    background-color: {{bg}};
}

/* ── Сайдбар ────────────────────────────────────────────────────────────── */

#Sidebar {
    background-color: {{surface}};
    border-right: 1px solid {{border}};
}

#ProfileName {
    font-size: 11pt;
    font-weight: bold;
    color: {{text}};
}

#SectionTitle {
    font-size: 12pt;
    font-weight: bold;
    color: {{text}};
}

#ChatPane {
    background-color: {{bg}};
}

#ProfileSub {
    color: {{text-muted}};
    font-size: 9pt;
}

/* ── Поиск ──────────────────────────────────────────────────────────────── */

QLineEdit#SearchField {
    background-color: {{surface-2}};
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 8px 12px 8px 34px;
    color: {{text}};
    selection-background-color: {{accent}};
    selection-color: #FFFFFF;
}

QLineEdit#SearchField:hover {
    background-color: {{surface-3}};
}

QLineEdit#SearchField:focus {
    background-color: {{surface}};
    border: 1px solid {{accent}};
}

/* ── Список чатов ───────────────────────────────────────────────────────── */

QListWidget#ChatList {
    background: transparent;
    border: none;
    outline: 0;
}

QListWidget#ChatList::item {
    border-radius: 12px;
    padding: 0px;
    margin: 2px 0px;
    color: {{text}};
}

QListWidget#ChatList::item:hover {
    background-color: {{hover}};
}

QListWidget#ChatList::item:selected {
    background-color: {{selected}};
    color: {{text}};
}

/* ── Кнопки-иконки ──────────────────────────────────────────────────────── */

QToolButton#IconButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    padding: 6px;
}

QToolButton#IconButton:hover {
    background-color: {{hover}};
}

QToolButton#IconButton:pressed {
    background-color: {{surface-3}};
}

/* ── Кнопки ─────────────────────────────────────────────────────────────── */

QPushButton#PrimaryButton {
    background-color: {{accent}};
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 9px 18px;
    font-weight: bold;
}

QPushButton#PrimaryButton:hover {
    background-color: {{accent-hover}};
}

QPushButton#PrimaryButton:pressed {
    background-color: {{accent-pressed}};
}

QPushButton#PrimaryButton:disabled {
    background-color: {{surface-3}};
    color: {{text-faint}};
}

QPushButton#GhostButton {
    background-color: transparent;
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 10px;
    padding: 8px 16px;
}

QPushButton#GhostButton:hover {
    background-color: {{hover}};
}

QPushButton#LinkButton {
    background: transparent;
    border: none;
    color: {{accent}};
    padding: 2px 4px;
}

QPushButton#LinkButton:hover {
    color: {{accent-hover}};
    text-decoration: underline;
}

/* ── Поля ввода ─────────────────────────────────────────────────────────── */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: {{surface}};
    border: 1px solid {{border}};
    border-radius: 10px;
    padding: 9px 12px;
    color: {{text}};
    selection-background-color: {{accent}};
    selection-color: #FFFFFF;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid {{accent}};
}

QLineEdit:disabled,
QTextEdit:disabled {
    color: {{text-faint}};
    background-color: {{surface-2}};
}

QLineEdit::placeholder {
    color: {{text-faint}};
}

/* ── Пустые состояния ───────────────────────────────────────────────────── */

#EmptyTitle {
    font-size: 13pt;
    font-weight: bold;
    color: {{text}};
}

#EmptySubtitle {
    font-size: 10pt;
    color: {{text-muted}};
}

#EmptyBadge {
    background-color: {{surface-2}};
    border-radius: 32px;
}

/* ── Скроллбары ─────────────────────────────────────────────────────────── */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px 2px 2px 0px;
}

QScrollBar::handle:vertical {
    background-color: {{scroll}};
    border-radius: 4px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{scroll-hover}};
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0px 2px 2px 2px;
}

QScrollBar::handle:horizontal {
    background-color: {{scroll}};
    border-radius: 4px;
    min-width: 32px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── Меню, тултипы, диалоги ─────────────────────────────────────────────── */

QMenu {
    background-color: {{surface}};
    border: 1px solid {{border}};
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 8px;
    color: {{text}};
}

QMenu::item:selected {
    background-color: {{hover}};
}

QMenu::separator {
    height: 1px;
    background-color: {{border}};
    margin: 6px 4px;
}

QToolTip {
    background-color: {{surface}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 8px;
    padding: 6px 9px;
}

QCheckBox {
    color: {{text}};
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid {{border-strong}};
    background-color: {{surface}};
}

QCheckBox::indicator:checked {
    background-color: {{accent}};
    border-color: {{accent}};
}

QSplitter::handle {
    background-color: {{border}};
}

QSplitter::handle:horizontal {
    width: 1px;
}

/* ── Список чатов (рисуется делегатом) ──────────────────────────────────── */

QListView#ChatList {
    background: transparent;
    border: none;
    outline: 0;
}

/* ── Шапка чата ─────────────────────────────────────────────────────────── */

#ChatHeader {
    background-color: {{surface}};
    border-bottom: 1px solid {{border}};
}

#ChatTitle {
    font-size: 11pt;
    font-weight: bold;
    color: {{text}};
}

#ChatStatus {
    color: {{text-muted}};
    font-size: 9pt;
}

/* ── Лента сообщений ────────────────────────────────────────────────────── */

#MessageArea, #MessageContent {
    background-color: {{bg}};
    border: none;
}

#MessageBubble {
    background: transparent;
}

#DayChip {
    background-color: {{surface-2}};
    color: {{text-muted}};
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 8.5pt;
}

#BubbleOwn {
    background-color: {{accent}};
    border-radius: 16px;
}

#BubbleOther {
    background-color: {{surface}};
    border: 1px solid {{border}};
    border-radius: 16px;
}

#BubbleOwn QLabel {
    color: #FFFFFF;
}

#BubbleOther QLabel {
    color: {{text}};
}

#MessageText {
    font-size: 10pt;
}

#MessageTime {
    color: {{text-faint}};
    font-size: 8pt;
}

#BubbleOwn #MessageTime {
    color: rgba(255, 255, 255, 190);
}

#MessageStatus {
    color: {{text-faint}};
    font-size: 8.5pt;
}

#BubbleOwn #MessageStatus {
    color: rgba(255, 255, 255, 190);
}

#MessageStatus[state="read"] {
    color: {{accent}};
}

#BubbleOwn #MessageStatus[state="read"] {
    color: #FFFFFF;
}

#MessageStatus[state="failed"] {
    color: {{danger}};
}

/* ── Панель ввода ───────────────────────────────────────────────────────── */

#Composer {
    background-color: {{surface}};
    border-top: 1px solid {{border}};
}

#ComposerEdit {
    background-color: {{surface-2}};
    border: 1px solid transparent;
    border-radius: 14px;
    padding: 8px 12px;
    color: {{text}};
}

#ComposerEdit:focus {
    background-color: {{surface}};
    border: 1px solid {{accent}};
}

QToolButton#SendButton {
    background-color: {{accent}};
    border: none;
    border-radius: 18px;
}

QToolButton#SendButton:hover {
    background-color: {{accent-hover}};
}

QToolButton#SendButton:pressed {
    background-color: {{accent-pressed}};
}

QToolButton#SendButton:disabled {
    background-color: {{surface-3}};
}

/* ── Баннер соединения ──────────────────────────────────────────────────── */

#ConnectionBanner {
    background-color: {{warning}};
    color: #1F1300;
    padding: 6px;
    font-size: 9pt;
}

/* ── Экран входа ────────────────────────────────────────────────────────── */

#LoginCard {
    background-color: {{surface}};
    border: 1px solid {{border}};
    border-radius: 20px;
}

#LoginTitle {
    font-size: 16pt;
    font-weight: bold;
    color: {{text}};
}

#LoginInput {
    background-color: {{surface-2}};
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 10px 12px;
    color: {{text}};
}

#LoginInput:focus {
    background-color: {{surface}};
    border: 1px solid {{accent}};
}

QPushButton#TabButton {
    background: transparent;
    border: none;
    padding: 8px;
    border-radius: 10px;
    color: {{text-muted}};
}

QPushButton#TabButton:checked {
    background-color: {{accent-soft}};
    color: {{accent}};
    font-weight: bold;
}

#ErrorLabel {
    color: {{danger}};
    font-size: 9pt;
}

QStatusBar {
    background-color: {{bg}};
    color: {{text-muted}};
}

#LoginStatus {
    color: {{text-muted}};
    font-size: 9pt;
}

/* ── Вложения ───────────────────────────────────────────────────────────── */

#AttachmentImage {
    background-color: transparent;
    border-radius: 12px;
    color: {{text-muted}};
    padding: 4px;
}

#AttachmentFile {
    background-color: {{surface-2}};
    border: 1px solid {{border}};
    border-radius: 12px;
    color: {{text}};
    padding: 10px 14px;
}

#BubbleOwn #AttachmentFile {
    background-color: rgba(255, 255, 255, 40);
    border: 1px solid rgba(255, 255, 255, 60);
    color: #FFFFFF;
}

/* ── Просмотр медиа ─────────────────────────────────────────────────────── */

#ImageViewer, #VideoViewer {
    background-color: #0E1014;
}

#ViewerImage {
    color: #E8EAED;
    background: transparent;
}

#VideoSurface {
    background-color: #000000;
}

#VideoViewer QLabel {
    color: #E8EAED;
}

#SearchDialog {
    background-color: {{bg}};
}

QListWidget#SearchResults {
    background: transparent;
    border: none;
}

QListWidget#SearchResults::item {
    padding: 8px 10px;
    border-radius: 8px;
    color: {{text}};
}

QListWidget#SearchResults::item:hover {
    background-color: {{hover}};
}

QListWidget#SearchResults::item:selected {
    background-color: {{selected}};
}

#SettingsDialog {
    background-color: {{bg}};
}

QComboBox#SettingsCombo {
    background-color: {{surface}};
    border: 1px solid {{border}};
    border-radius: 8px;
    padding: 6px 10px;
    color: {{text}};
    min-width: 140px;
}

QComboBox#SettingsCombo::drop-down {
    border: none;
    width: 22px;
}

QComboBox#SettingsCombo QAbstractItemView {
    background-color: {{surface}};
    color: {{text}};
    selection-background-color: {{selected}};
    border: 1px solid {{border}};
}

#Toast {
    background-color: {{danger}};
    color: #FFFFFF;
    padding: 8px 14px;
    font-size: 9pt;
}

#ParticipantsPanel {
    background-color: {{surface}};
    border-left: 1px solid {{border}};
}

#ParticipantRow {
    border-radius: 8px;
}

#ParticipantRow:hover {
    background-color: {{hover}};
}

#ParticipantName {
    font-weight: 600;
    font-size: 10pt;
}

#ParticipantStatus {
    color: {{text-muted}};
    font-size: 8pt;
}
#ComposerPreview {
    background: transparent;
}

#AttachmentChip {
    background-color: {{surface-3}};
    border: 1px solid {{border}};
    border-radius: 8px;
}

#AttachmentChipName {
    color: {{text}};
    font-size: 9pt;
}

#AttachmentChipRemove {
    background: transparent;
    border: none;
    color: {{text-muted}};
    font-size: 13pt;
    padding: 0;
}

#AttachmentChipRemove:hover {
    color: {{danger}};
}

#EmojiButton {
    background: transparent;
    border: none;
    font-size: 16pt;
    padding: 0;
}

#EmojiButton:hover {
    background-color: {{hover}};
    border-radius: 6px;
}

#EmojiPicker {
    background-color: {{surface}};
    border: 1px solid {{border}};
}

#EmojiPicker QLineEdit {
    background-color: {{surface-2}};
    border: 1px solid {{border}};
    border-radius: 6px;
    padding: 6px 8px;
}
#ReplyQuote {
    background-color: {{surface-2}};
    border-left: 3px solid {{accent}};
    border-radius: 6px;
}

#ReplyQuoteName {
    color: {{accent}};
    font-size: 8.5pt;
    font-weight: 600;
}

#ReplyQuoteBody {
    color: {{text-muted}};
    font-size: 8.5pt;
}

#BubbleAction {
    background: transparent;
    border: none;
    color: {{text-muted}};
    font-size: 8pt;
    padding: 0 4px;
}

#BubbleAction:hover {
    color: {{accent}};
}

#ComposerReply {
    background-color: {{surface-2}};
    border-radius: 6px;
}

#ComposerReplyText {
    color: {{text-muted}};
    font-size: 8.5pt;
}

#MessageStatus[state="read"] {
    color: {{accent}};
}