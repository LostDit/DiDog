        <file alias="icons/search.svg">icons/search.svg</file>
        <file alias="icons/plus.svg">icons/plus.svg</file>
        <file alias="icons/paperclip.svg">icons/paperclip.svg</file>
        <file alias="icons/send.svg">icons/send.svg</file>
        <file alias="icons/settings.svg">icons/settings.svg</file>
        <file alias="icons/more.svg">icons/more.svg</file>
    </qresource>
</RCC>
